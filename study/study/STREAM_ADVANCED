import java.util.*;
import java.util.stream.Collectors;

public class EmployeeToMap {

    public static void main(String[] args) {

        List<Employee> employees = List.of(
                new Employee(1, 5000),
                new Employee(2, 7000),
                new Employee(1, 8000), // duplicate id
                new Employee(3, 6000),
                new Employee(2, 6500)  // duplicate id
        );
-----main logic------
        Map<Integer, Employee> employeeMap = employees.stream()
                .collect(Collectors.toMap(
                        Employee::getId,            // key mapper
                        emp -> emp,                  // value mapper
                        (e1, e2) ->                 // merge function for duplicate keys
                                e1.getSalary() >= e2.getSalary() ? e1 : e2
                ));

        employeeMap.forEach((id, emp) ->
                System.out.println(id + " -> " + emp)
        );
    }
}
