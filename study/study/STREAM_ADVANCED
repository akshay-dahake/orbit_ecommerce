2.you are given a list of employees each employee has a list of skills give a unique sorted list of all skills accross all employess in java stream


import java.util.List;

class Employee {
    String name;
    List<String> skills;

    public Employee(String name, List<String> skills) {
        this.name = name;
        this.skills = skills;
    }
}



import java.util.*;
import java.util.stream.Collectors;

public class UniqueSortedSkills {

    public static void main(String[] args) {

        List<Employee> employees = Arrays.asList(
                new Employee("Alice", Arrays.asList("Java", "Python", "SQL")),
                new Employee("Bob", Arrays.asList("Python", "JavaScript")),
                new Employee("Charlie", Arrays.asList("SQL", "C++", "Java"))
        );

        // Get unique sorted list of skills
        List<String> uniqueSkills = employees.stream()
                .flatMap(emp -> emp.getSkills.stream())   // flatten all skills into a single stream
                .distinct()                            // keep only unique skills
                .sorted()                              // sort alphabetically
                .collect(Collectors.toList());         // collect as list

        System.out.println(uniqueSkills);
    }
}

