Create DataSource Config for employee (Primary)
@Configuration
@EnableJpaRepositories(
    basePackages = "com.example.employee.repo",
    entityManagerFactoryRef = employeeEntityManagerFactory",
    transactionManagerRef = "employeeTransactionManager"
)
public class EmployeeConfig {

    @Primary               // this is only one entity here it is in employee so in dept it is not there   , this will be default datasource 
    			 //When multiple beans of the same type exist, Spring needs ONE default choice.
    @Bean
    @ConfigurationProperties("spring.datasource.employee")
    public DataSource employeeDataSource() {
        return DataSourceBuilder.create().build();
    }

    @Primary
    @Bean
    public LocalContainerEntityManagerFactoryBean employeeEntityManagerFactory(
            EntityManagerFactoryBuilder builder) {
        return builder
                .dataSource(employeeDataSource())
                .packages("com.example.employee.entity")
                .persistenceUnit("employee")
                .build();
    }

    @Primary
    @Bean
    public PlatformTransactionManager employeeTransactionManager(
            EntityManagerFactory emf) {
        return new JpaTransactionManager(emf);
    }
}

3️⃣ Create DataSource Config for dept
@Configuration
@EnableJpaRepositories(
    basePackages = "com.example.dept.repo",
    entityManagerFactoryRef = "deptEntityManagerFactory",
    transactionManagerRef = "deptTransactionManager"
)
public class DeptConfig {

    @Bean
    @ConfigurationProperties("spring.datasource.dept")
    public DataSource deptDataSource() {
        return DataSourceBuilder.create().build();
    }

    @Bean
    public LocalContainerEntityManagerFactoryBean deptEntityManagerFactory(
            EntityManagerFactoryBuilder builder) {
        return builder
                .dataSource(deptDataSource())
                .packages("com.example.dept.entity")
                .persistenceUnit("dept")
                .build();
    }

    @Bean
    public PlatformTransactionManager deptTransactionManager(
            EntityManagerFactory emf) {
        return new JpaTransactionManager(emf);
    }
}

