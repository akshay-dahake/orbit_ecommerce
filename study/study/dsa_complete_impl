1. single linked list

class LinkedListDSA {

    // Node structure
    class Node {
        int data;
        Node next;

        Node(int data) {
            this.data = data;
            this.next = null;
        }
    }

    Node head; // head of the list

    // 1️⃣ Add at the beginning
    public void addFirst(int data) {
        Node newNode = new Node(data);
        newNode.next = head;
        head = newNode;
    }

    // 2️⃣ Add at the end
    public void addLast(int data) {
        Node newNode = new Node(data);

        if (head == null) {
            head = newNode;
            return;
        }

        Node temp = head;
        while (temp.next != null) {
            temp = temp.next;
        }
        temp.next = newNode;
    }

    // 3️⃣ Delete a node by value
    public void delete(int key) {

        // If list is empty
        if (head == null) {
            System.out.println("List is empty");
            return;
        }

        // If head needs to be deleted
        if (head.data == key) {
            head = head.next;
            return;
        }

        Node curr = head;
        Node prev = null;

        while (curr != null && curr.data != key) {
            prev = curr;
            curr = curr.next;
        }

        // If key not found
        if (curr == null) {
            System.out.println("Element not found");
            return;
        }

        // Remove node
        prev.next = curr.next;
    }

    // 4️⃣ Print the linked list
    public void printList() {
        if (head == null) {
            System.out.println("List is empty");
            return;
        }

        Node temp = head;
        while (temp != null) {
            System.out.print(temp.data + " -> ");
            temp = temp.next;
        }
        System.out.println("null");
    }

    // 5️⃣ Main method (Testing)
    public static void main(String[] args) {
        LinkedListDSA list = new LinkedListDSA();

        list.addFirst(10);
        list.addFirst(20);
        list.addLast(30);
        list.addLast(40);

        System.out.print("Linked List: ");
        list.printList();

        list.delete(20);
        System.out.print("After deleting 20: ");
        list.printList();

        list.delete(100); // not present
    }
}






