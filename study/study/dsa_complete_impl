class RemoveLoop {

    class Node {
        int data;
        Node next;

        Node(int data) {
            this.data = data;
        }
    }

    Node head;

    // Remove loop if exists
    public void removeLoop() {
        Node slow = head, fast = head;
        boolean loopExists = false;

        // Detect loop
        while (fast != null && fast.next != null) {
            slow = slow.next;
            fast = fast.next.next;

            if (slow == fast) {
                loopExists = true;
                break;
            }
        }

        if (!loopExists) return;

        // Find start of loop
        slow = head;
        while (slow != fast) {
            slow = slow.next;
            fast = fast.next;
        }

        // Remove loop
        while (fast.next != slow) {
            fast = fast.next;
        }
        fast.next = null;
    }
}



